generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Roles exactamente como en la versión final del mockup: el Administrador ve
/// y puede todo (no pasa por la matriz de permisos); los otros tres roles se
/// rigen por la matriz editable en RolePermission.
enum Role {
  ADMIN
  GERENTE
  ADMINISTRATIVO
  VENDEDOR
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum CustomerType {
  INDIVIDUAL
  CORPORATE
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

/// Tipo de registro financiero (antes ExpenseType). "OTRO" se agrega porque el
/// mockup lo incluye como cuarto tipo además de Gasto/Costo/Inversión.
enum RecordType {
  GASTO
  COSTO
  INVERSION
  OTRO
}

enum PaymentKind {
  PROVEEDOR
  NOMINA
  CREDITO
  OTRO
}

enum PayeeType {
  PROVEEDOR
  EMPLEADO
  OTRO
}

enum PaymentRecordStatus {
  PENDIENTE
  PAGADO
}

model Store {
  id         String   @id @default(cuid())
  name       String
  address    String?
  phone      String?
  active     Boolean  @default(true)
  /// Logo propio de la sede (data URL base64), como en el mockup — cada tienda
  /// puede tener un logo distinto, ya no hay un logo único de empresa.
  logo       String?  @db.LongText
  /// Color de acento de la tienda (hex), aplicado en vivo a toda la UI.
  themeColor String?
  adminId    String?
  admin      User?    @relation("StoreAdmin", fields: [adminId], references: [id])
  vendedorId String?
  vendedor   User?    @relation("StoreVendedor", fields: [vendedorId], references: [id])
  createdAt  DateTime @default(now())

  users            User[]            @relation("StoreUsers")
  products         Product[]
  supplies         Supply[]
  orders           Order[]
  expenses         Expense[]
  payments         Payment[]
  supplierInvoices SupplierInvoice[]
  budgetEntries    BudgetEntry[]
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  role            Role      @default(VENDEDOR)
  storeId         String?
  store           Store?    @relation("StoreUsers", fields: [storeId], references: [id])
  active          Boolean   @default(true)
  /// Si es false, es un empleado registrado (ej. domiciliario) sin acceso al sistema.
  hasSystemAccess Boolean   @default(true)
  documentId      String?
  phone           String?
  position        String?
  hireDate        DateTime? @db.Date
  contractType    String?
  eps             String?
  pensionFund     String?
  arl             String?
  salary          Decimal?  @db.Decimal(12, 2)
  /// Horario personalizado por día (si no usa una jornada con nombre), { LUN:{off,start,end}, ... }.
  schedule        Json?
  jornadaId       String?
  jornada         Jornada?  @relation(fields: [jornadaId], references: [id])
  createdAt       DateTime  @default(now())

  createdOrders    Order[]   @relation("OrderCreatedBy")
  assignedOrders   Order[]   @relation("OrderAssignedTo")
  deliveryOrders   Order[]   @relation("OrderDeliveryPerson")
  expenses         Expense[]
  storesAsAdmin    Store[]   @relation("StoreAdmin")
  storesAsVendedor Store[]   @relation("StoreVendedor")
  payments         Payment[] @relation("PaymentEmployee")
}

/// Matriz de permisos editable por rol (Administración → Roles y permisos).
/// ADMIN no se guarda aquí: siempre tiene acceso total (ver lib/permissions.ts).
model RolePermission {
  id      String  @id @default(cuid())
  role    Role
  key     String
  allowed Boolean @default(false)

  @@unique([role, key])
}

/// Jornada con nombre (turno) reutilizable entre empleados.
model Jornada {
  id    String @id @default(cuid())
  name  String
  /// { LUN:true, MAR:true, ... DOM:false }
  days  Json
  start String
  end   String

  users User[]
}

/// Listas desplegables administrables (Administración → Listas desplegables):
/// formas de pago, categorías de producto, cargos, EPS, ARL, fondos de pensión,
/// tipos de contrato, relaciones de persona, canales de adquisición, unidades
/// de insumo, categorías de gasto/costo/inversión/otro.
model ListOption {
  id        String @id @default(cuid())
  listKey   String
  value     String
  sortOrder Int    @default(0)

  @@unique([listKey, value])
  @@index([listKey])
}

/// Mensajes de tarjeta sugeridos por ocasión. El conjunto de ocasiones del
/// sistema es, como en el mockup, el conjunto de valores distintos de `occasion`
/// aquí (lista virtual "occasions" totalmente editable).
model CardMessageTemplate {
  id        String @id @default(cuid())
  occasion  String
  message   String @db.Text
  sortOrder Int    @default(0)

  @@index([occasion])
}

/// Datos de la empresa (un solo registro compartido) + contador global de
/// numeración de pedidos ("CP-000001", igual que en el mockup).
model CompanySettings {
  id                String  @id @default("singleton")
  razonSocial       String?
  nit               String?
  address           String?
  phone             String?
  email             String?
  resolution        String?
  nextInvoiceNumber Int     @default(1)
}

model Customer {
  id                 String       @id @default(cuid())
  name               String
  phone              String?
  email              String?
  notes              String?
  type               CustomerType @default(INDIVIDUAL)
  documentId         String?
  birthDate          DateTime?
  acquisitionChannel String?
  tags               String?
  createdAt          DateTime     @default(now())

  lastOrderAt   DateTime?
  ordersCount   Int       @default(0)
  lifetimeValue Decimal   @default(0) @db.Decimal(10, 2)

  /// Formas de pago preferidas del cliente, lista de strings.
  paymentMethods Json @default("[]")
  /// Correos adicionales del cliente, lista de strings.
  emails         Json @default("[]")

  personas Persona[]
  orders   Order[]

  @@index([lastOrderAt])
}

/// Modelo unificado de "personas" del mockup: el cliente (titular) y cada
/// destinatario frecuente (hijo, pareja, oficina...) con sus propias
/// direcciones y fechas especiales.
model Persona {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  isTitular    Boolean  @default(false)
  phone        String?
  createdAt    DateTime @default(now())

  addresses    CustomerAddress[]
  specialDates CustomerSpecialDate[]
  orders       Order[]

  @@index([customerId])
}

model CustomerAddress {
  id            String   @id @default(cuid())
  personaId     String
  persona       Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  label         String
  recipientName String?
  phone         String?
  address       String
  city          String?
  /// Zona de entrega (Norte/Sur/Oeste/Oriente), editable manualmente o
  /// autodetectada por palabra clave en la dirección (ver lib/zone.ts).
  zone          String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([personaId])
}

model CustomerSpecialDate {
  id        String   @id @default(cuid())
  personaId String
  persona   Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  label     String
  month     Int
  day       Int
  notes     String?
  createdAt DateTime @default(now())

  @@index([personaId])
}

model Supplier {
  id           String   @id @default(cuid())
  name         String
  contactName  String?
  phone        String?
  email        String?
  address      String?
  city         String?
  taxId        String?
  categories   String?
  paymentTerms String?
  leadTimeDays Int?
  rating       Int?
  active       Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())

  supplies         Supply[]
  supplierInvoices SupplierInvoice[]
  payments         Payment[]         @relation("PaymentSupplier")
}

/// Insumo (materia prima), SIEMPRE por tienda — igual que en el mockup, cada
/// tienda tiene su propio inventario de insumos independiente.
model Supply {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id])
  name        String
  unit        String
  costPerUnit Decimal   @db.Decimal(12, 4)
  stock       Decimal   @default(0) @db.Decimal(12, 2)
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  recipeItems          ProductSupply[]
  supplierInvoiceItems SupplierInvoiceItem[]

  @@index([storeId])
}

/// Receta (bill of materials) de un producto: qué insumos de ESA MISMA tienda
/// usa y en qué cantidad, igual que en el mockup (la receta no se comparte
/// entre tiendas aunque el producto esté vinculado por groupId).
model ProductSupply {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplyId  String
  supply    Supply  @relation(fields: [supplyId], references: [id])
  quantity  Decimal @db.Decimal(12, 2)

  @@index([productId])
}

model Product {
  id                String    @id @default(cuid())
  storeId           String
  store             Store     @relation(fields: [storeId], references: [id])
  name              String
  description       String?
  /// Categoría de producto: valor libre validado contra ListOption("productCategories").
  category          String    @default("Otros")
  sku               String?
  color             String?
  tags              String?
  unit              String    @default("unidad")
  unitPrice         Decimal   @db.Decimal(10, 2)
  costPrice         Decimal?  @db.Decimal(10, 2)
  /// Mano de obra, componente del costo total además de la receta de insumos.
  laborCost         Decimal   @default(0) @db.Decimal(10, 2)
  stock             Int       @default(0)
  lowStockThreshold Int       @default(5)
  reorderQuantity   Int?
  shelfLifeDays     Int?
  receivedAt        DateTime?
  /// Clave compartida entre copias del "mismo" producto en distintas tiendas
  /// (cada tienda mantiene su propia fila independiente: precio/stock/receta
  /// pueden divergir luego de creado).
  groupId           String?
  coverPhoto        String?   @db.LongText
  photos            Json?
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())

  orderItems OrderItem[]
  recipe     ProductSupply[]

  @@index([storeId])
  @@index([category])
  @@index([groupId])
}

model Order {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  createdById   String
  createdBy     User     @relation("OrderCreatedBy", fields: [createdById], references: [id])
  assignedToId  String?
  assignedTo    User?    @relation("OrderAssignedTo", fields: [assignedToId], references: [id])

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod String?
  /// Clave de ocasión: valor libre, uno de los definidos en CardMessageTemplate/ListOption("occasions").
  occasion      String?

  recipientPersonaId String?
  recipientPersona   Persona? @relation(fields: [recipientPersonaId], references: [id])
  /// Snapshot del nombre del destinatario al momento del pedido.
  recipientName      String?
  recipientPhone     String?
  cardMessage        String?  @db.Text

  deliveryMethod  DeliveryMethod @default(DELIVERY)
  /// Snapshot de la dirección elegida al momento del pedido.
  deliveryAddress String?
  deliveryCity    String?
  /// Fecha programada de entrega/recogida.
  deliveryDate    DateTime?      @db.Date
  /// Jornada programada: Mañana/Tarde/Noche.
  scheduledShift  String?
  /// Hora programada en texto "HH:MM".
  scheduledHour   String?

  deliveryPersonId     String?
  deliveryPerson       User?   @relation("OrderDeliveryPerson", fields: [deliveryPersonId], references: [id])
  isThirdPartyDelivery Boolean @default(false)
  thirdPartyDriverName String?
  thirdPartyPlate      String?

  notes       String? @db.Text
  subtotal    Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  deliveryFee Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  /// Última fase para la que se disparó la notificación de WhatsApp (se vuelve
  /// a mostrar el badge "Cliente notificado" en cada fase nueva).
  notifiedStatus  OrderStatus?
  cardPrinted     Boolean      @default(false)
  dispatchPrinted Boolean      @default(false)

  /// Encuesta de satisfacción (muestreo 1 de cada 5 pedidos entregados).
  surveySelected Boolean?
  rating         Int?
  ratingComment  String?  @db.Text
  qCalidad       Int?
  qPuntualidad   Int?
  qRecomendacion Int?
  surveyNotes    String?  @db.Text

  externalReference String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([storeId])
  @@index([customerId])
  @@index([status])
  @@index([deliveryPersonId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  /// Snapshot del nombre del producto al momento del pedido (igual que el mockup:
  /// si el producto se renombra después, el histórico no cambia).
  productName String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  subtotal    Decimal @db.Decimal(10, 2)
}

model Expense {
  id          String     @id @default(cuid())
  storeId     String
  store       Store      @relation(fields: [storeId], references: [id])
  type        RecordType
  category    String
  description String?
  amount      Decimal    @db.Decimal(10, 2)
  date        DateTime
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())

  @@index([storeId])
  @@index([date])
  @@index([type])
}

/// "Pagos" — liquidación de pagos a proveedores/nómina/crédito/otros.
model Payment {
  id         String              @id @default(cuid())
  storeId    String
  store      Store               @relation(fields: [storeId], references: [id])
  type       PaymentKind
  payeeType  PayeeType
  supplierId String?
  supplier   Supplier?           @relation("PaymentSupplier", fields: [supplierId], references: [id])
  employeeId String?
  employee   User?               @relation("PaymentEmployee", fields: [employeeId], references: [id])
  /// Solo cuando payeeType = OTRO (beneficiario en texto libre).
  payeeName  String?
  amount     Decimal             @db.Decimal(10, 2)
  date       DateTime
  method     String?
  status     PaymentRecordStatus @default(PENDIENTE)
  notes      String?
  createdAt  DateTime            @default(now())

  @@index([storeId])
  @@index([status])
  @@index([type])
}

/// Factura de proveedor recibida en Insumos: registra la compra y actualiza
/// stock + costo promedio ponderado del insumo correspondiente.
model SupplierInvoice {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id])
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  invoiceNumber String
  date          DateTime
  total         Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  items SupplierInvoiceItem[]

  @@index([storeId])
}

model SupplierInvoiceItem {
  id        String          @id @default(cuid())
  invoiceId String
  invoice   SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  supplyId  String
  supply    Supply          @relation(fields: [supplyId], references: [id])
  quantity  Decimal         @db.Decimal(12, 2)
  unitCost  Decimal         @db.Decimal(12, 4)
}

/// Presupuesto de ventas por tienda/mes/producto. Clave por NOMBRE de producto
/// (no por id) a propósito, igual que el mockup: el presupuesto sobrevive aunque
/// cambie el id del producto.
model BudgetEntry {
  id          String  @id @default(cuid())
  storeId     String
  store       Store   @relation(fields: [storeId], references: [id])
  /// "YYYY-MM"
  month       String
  productName String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(10, 2)

  @@unique([storeId, month, productName])
  @@index([storeId, month])
}
